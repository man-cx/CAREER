 x="42" y="1831" w="67" h="41"><t w="29">IL</t><t w="29">It</t><t w="17">11</t><t w="12">KI</t></item><item x="44" y="1781" w="87" h="41"><t w="20">If</t></item><item x="50" y="783" w="66" h="93"><t w="24">ilii</t></item><item x="903" y="387" w="27" h="51"><t w="28">LI</t><t w="23">u</t><t w="18">m</t></item><item x="1511" y="1061" w="31" h="69"><t w="22">as</t></item><item x="1623" y="1622" w="10" h="46"><t w="18">SS</t><t w="16">SG</t></item><item x="317" y="158" w="74" h="56"><t w="23">I·</t><t w="21">y</t><t w="19">b</t><t w="19">h</t></item><item x="52" y="1276" w="38" h="40"><t w="57">Il</t><t w="42">!J</t><t w="41">ll</t><t w="37">I!</t><t w="31">II</t><t w="30">1!</t><t w="29">l!</t><t w="28">J!</t><t w="25">JI</t><t w="24">11</t></item></recoIndex>]]></recognition><resource-attributes><timestamp>19700101T000000Z</timestamp><reco-type>unknown</reco-type><file-name>Evernote Camera Roll 20150802 200939.png</file-name></resource-attributes></resource></note>
<note><title>中國進口跨境電商的發展和港商的機遇 | 香港貿發局</title><content><![CDATA[<?xml version="1.0" encoding="utf-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><br/><div style="font-size: 16px"><div style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;"><div style="font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:12px;font-style:normal;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;text-align:center;color:rgb(0, 0, 0);background-color:rgb(255, 255, 255);"><div style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;background-color:rgb(255, 255, 255);"><div style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;text-align:left;"><div style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;"><div style="font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;"> 
								


























	
	 
				



	 
		
		<h2 style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:16px;font-style:normal;font-variant:inherit;font-weight:normal;line-height:1.8em;word-wrap:break-word;white-space:normal;color:rgb(0, 0, 0);">
	
	2015年9月1日

	 
		</h2>
	
	
			
			
			
			
	 
		<h3 style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:20px;font-style:normal;font-variant:inherit;font-weight:normal;line-height:23px;word-wrap:break-word;white-space:normal;color:rgb(244, 121, 32);margin-bottom:10px;">
	
		中國進口跨境電商的發展和港商的機遇 

	
	
	
							
	
			<en-media type="image/gif" hash="cd4e5bd0b496512cae4b6ab344b203a7" alt="聲音檔案" title="聲音檔案" width="14" height="11" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;"></en-media>
		
	
	 
		</h3>
	
	

		
		
			
			
			
			
				
			
			
			
			
			
			
			
			
			
			<span>
					
					
						 
						
					
					
					
					<p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">中國內地消費者對外國進口產品的需求殷切，部分消費者利用互聯網通過海淘或代購的方式購買。不過，當中不時會發生一些問題，例如商品質量無法保證、甚至可能是假冒、無法退貨、涉嫌漏稅等。為進一步保障消費者的權益、增加對商品安全的監控和保障國家稅收等，中國政府在內地7個城市展開跨境貿易電子商務試點[1]，同時自貿區和有條件的城市也可以展開跨境電商進口業務。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">中國跨境電商[2]B2C的發展蓬勃，不少進口跨境電商平台[3]積極尋找外國進口商品的供應商、代理商和品牌商，以滿足內地消費者對新品牌、新商品的要求。香港企業有多年與外國商家合作的經驗，對海外產品熟悉，同時又瞭解中國內地消費者的需求特性，相信香港的貿易商、進口商和代理商等，在引入外國商品到內地市場上有一定的優勢。因此港商可考慮利用跨境電商平台，拓展內地B2C的消費市場。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">展開跨境電商B2C進口業務的城市</strong></p><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;background-color:rgb(255, 255, 255);"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;"> </span><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:100%;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:300px;margin-left:0px;margin-right:20px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;margin-top:5px;margin-bottom:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"> <table border="0" width="300" style="font-size:inherit;font-weight:inherit;font-style:inherit;font-variant:inherit;box-sizing:border-box;border-spacing:0px;border-collapse:collapse;max-width:100%;background-color:transparent;"><tbody style="box-sizing:border-box;"><tr style="box-sizing:border-box;"><td style="box-sizing:border-box;padding:0px;"> </td><td style="box-sizing:border-box;padding:0px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;width:300px;height:167px;"></div></td></tr><tr style="box-sizing:border-box;"><td style="box-sizing:border-box;padding:0px;"> <a name="#1" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"></a></td><td style="box-sizing:border-box;padding:0px;"></td></tr></tbody></table></div></div></div><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;box-sizing:border-box;">據中國電子商務研究中心的預測，中國內地「海淘族」[4]人數將由2014年的1,800萬人，增長到2018年的3,560萬人。而經海淘交易的規模將由2014年的1,500億元(人民幣，下同)上升到2018年的10,000億元；可見內地消費者對外國商品的需求將會持續增加。不過，部分消費者直接到海外網站或以代購的方式購買外國進口商品，不時遇到一些問題，例如語言障礙、商品質量沒有保障、物流延期、商品遺失、涉嫌漏稅、商品被扣等。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;box-sizing:border-box;">為進一步保障消費者的權益、商品安全的監控和保障國家稅收等，國家發展改革委、人民銀行、海關總署等8部門於2012年聯合發布《<a href="http://dzsws.mofcom.gov.cn/article/zcfb/201202/20120207976459.shtml" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;box-sizing:border-box;color:blue;text-decoration:underline;">關於促進電子商務健康快速發展有關工作的通知</a>》(發改辦高技[2012]226號)，決定在相關示範城市推動地方電子口岸，展開跨境貿易電子商務[5]試點。目前中國內地共有7個跨境電商服務試點城市，包括上海、杭州、寧波、鄭州、重慶、廣州、深圳，可按「保稅進口」或「直購進口」模式進行跨境電商B2C的銷售業務。根據海關總署的報道，截至2014年12月底，這7個跨境電商進口服務試點城市，共檢驗和放行超過411萬件包裹，價值約10.1億元。</p></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;clear:both;"> </span></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span></div><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">據中華人民共和國海關總署的報道，除了國務院已批准上述的7個跨境電商進口試點城市外，自貿區和有條件的城市也可以展開進口跨境電商B2C的銷售業務，當中包括福建和天津的自貿區、南京、青島、平潭、煙台等。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">根據海關總署《<a href="http://www.customs.gov.cn/publish/portal0/tab9374/info714483.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">關於跨境貿易電子商務進出境貨物、物品有關監管事宜的公告</a>》(海關總署[2014]56號)，跨境貨物由海關監管，企業必須通過經海關認可並且與海關聯網對接的跨境進口電商平台，把訂單、支付、物流等訊息實時向海關申報，才能展開進口跨境B2C的銷售業務。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">雖然國務院現時只批准部分城市展開跨境電商B2C的銷售業務作為試點，但全國內地的消費者都可以通過跨境電商平台購物。例如，重慶的「<a href="http://economists-pick-research.hktdc.com/business-news/article/%E7%A0%94%E7%A9%B6%E6%96%87%E7%AB%A0/%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E5%B9%B3%E5%8F%B0%E7%9A%84%E9%81%8B%E4%BD%9C-%E9%87%8D%E6%85%B6-%E6%84%9B%E8%B3%BC%E4%BF%9D%E7%A8%85/rp/tc/1/1X32LK39/1X0A3L81.htm" target="_self" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">愛購保稅</a>」電商購物平台的消費者雖然以重慶本地和四川省的居民為主，但也吸引了北京、江蘇省、浙江省等的消費者。因此，跨境電商平台潛在的消費群是覆蓋整個中國內地市場。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"></p><table border="0" style="font-size:inherit;font-weight:inherit;font-style:inherit;font-variant:inherit;"><tbody><tr style="background-color:#a6a3a3;"><td style="width:15%;text-align:center;border-width:1px;border-image:none;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">試點城市</strong></td><td style="text-align:center;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">部分進口跨境電商平台</strong></td></tr><tr style="background-color:#d6d5d7;"><td style="text-align:center;">上海<br></br></td><td>跨境通(<a href="http://www.customs.gov.cn/publish/portal0/tab9374/info714483.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.kjt.com</a>)、上海外高橋進口商品網(<a href="http://www.ftzmall.com.cn/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.ftzmall.com.cn</a>)、美國購物網(<a href="http://www.usashopcn.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.usashopcn.com</a>)</td></tr><tr><td style="text-align:center;">杭州</td><td>天貓國際(<a href="http://www.tmall.hk/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.tmall.hk</a>)、鮮life(<a href="http://www.xianlife.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.xianlife.com</a>)、海納(<a href="http://service-industries-research.hktdc.com/business-news/article/%E8%B3%87%E8%A8%8A%E5%8F%8A%E9%80%9A%E8%A8%8A%E7%A7%91%E6%8A%80/%E4%B8%AD%E5%9C%8B%E9%80%B2%E5%8F%A3%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E7%9A%84%E7%99%BC%E5%B1%95%E5%92%8C%E6%B8%AF%E5%95%86%E7%9A%84%E6%A9%9F%E9%81%87/rp/tc/1/1X3L128M/seaany.com" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">seaany.com</a>)</td></tr><tr style="background-color:#d6d5d7;"><td style="text-align:center;">寧波</td><td>跨境購(<a href="http://www.kjb2c.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.kjb2c.com</a>)、歐宜商城(<a href="http://www.hoyshop.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.hoyshop.com</a>)、洋樂購(<a href="http://www.yanglego.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.yanglego.com</a>)</td></tr><tr><td style="text-align:center;">鄭州 <br></br></td><td>萬國優品(<a href="http://www.wgyp.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.wgyp.com</a>)、聚美優品(<a href="http://www.jumei.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.jumei.com</a>)、考拉海購(<a href="http://www.kaola.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.kaola.com</a>)</td></tr><tr style="background-color:#d6d5d7;"><td style="text-align:center;">重慶</td><td>愛購保稅(<a href="http://www.igetmall.net/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.igetmall.net</a>)、跨境優品(<a href="http://www.kjyp360.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.kjyp360.com</a>)、世紀購(<a href="http://www.sjgo365.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.sjgo365.com</a>)</td></tr><tr><td style="text-align:center;">廣州</td><td>風信子(<a href="http://www.funsens.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.funsens.com</a>)、林貳林(<a href="http://www.sd020.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.sd020.com</a>)、美悅優選 (<a href="http://www.meijoybest.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.meijoybest.com</a>)</td></tr><tr style="background-color:#d6d5d7;"><td style="text-align:center;">深圳</td><td>ewj跨境購(<a href="http://www.ewj.hk/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.ewj.hk</a>)、前海開心購(<a href="http://www.kxg.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.kxg.com</a>)、海搗網(<a href="http://www.haidaowang.com/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">www.haidaowang.com</a>)</td></tr></tbody></table><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"> </p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">「保稅進口」和「直購進口」的模式</strong></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">目前跨境電商B2C的進口業務有2種模式：「保稅進口」和「直購進口」；一些跨境電商平台，例如「<a href="http://www.ftzmall.com.cn/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">上海外高橋進口商品網</a>」和重慶的「<a href="http://www.igetmall.net/" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">愛購保稅</a>」都有這2種進口模式。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">保稅進口(B2B2C)：採用「先備貨後接單」的形式，外國商品整批存放在中國境內海關的特殊監管區域或保稅監管場所內(例如保稅區、保稅港區、保稅物流中心等)。消費者通過與海關聯網的跨境電商平台下單後，電商平台根據訂單訊息、支付訊息、物流訊息實時向海關申報，並按照消費者訂單上的每件商品辦理通關手續，經海關查驗後，商品從保稅區直接清關發出給消費者。由於商品已存放在中國境內海關的特殊監管區域，在海關、檢驗檢疫局等監管下實現快速通關，消費者一般在3-4天內便收到商品，大大縮短了物流時間。不過企業的商品需要在中國海關的監管倉庫內備貨，因此「保稅進口」商品種類和款式可能較「直購進口」的少。</p><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;background-color:rgb(255, 255, 255);"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span><div style="margin:0px auto;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;padding-left:50px;"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;"> </span><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:600px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;margin-top:5px;margin-bottom:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"> <a href="http://service-industries-research.hktdc.com/business-news/article/%E8%B3%87%E8%A8%8A%E5%8F%8A%E9%80%9A%E8%A8%8A%E7%A7%91%E6%8A%80/%E4%B8%AD%E5%9C%8B%E9%80%B2%E5%8F%A3%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E7%9A%84%E7%99%BC%E5%B1%95%E5%92%8C%E6%B8%AF%E5%95%86%E7%9A%84%E6%A9%9F%E9%81%87/rp/tc/1/1X3L128M/1X0A3HYN.htm#" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;color:rgb(51, 51, 51);text-decoration:none;"><en-media type="image/jpeg" hash="6c5cadf9f163b47ef21cf28e9b33cb0f" title="圖：保稅進口" border="0" alt="圖：保稅進口" width="600" height="633" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;vertical-align:middle;margin-bottom:10px;width:600px;"></en-media></a><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:13px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"></div></div></div></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;clear:both;"> </span></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span></div><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"> </p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">直購進口(B2C)：採用「先下單後發貨」的形式，中國消費者通過與海關聯網的跨境電商平台下單，電商平台一方面把訂單訊息、支付訊息、物流訊息等實時傳送給中國海關；另一方面商品直接在海外倉庫發貨，通過國際物流配送，把商品運到中國內地海關的跨境電子商務監管場所，完成清關、檢驗檢疫等手續後便發貨給消費者。一般情況下消費者在7-15天便收到商品。由於「直購進口」商品按個別消費者的訂單從海外直接發貨，因此物流成本相對較高和運輸時間也較長。</p><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;background-color:rgb(255, 255, 255);"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span><div style="margin:0px auto;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;padding-left:50px;"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;"> </span><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:600px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;margin-top:5px;margin-bottom:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"> <a href="http://service-industries-research.hktdc.com/business-news/article/%E8%B3%87%E8%A8%8A%E5%8F%8A%E9%80%9A%E8%A8%8A%E7%A7%91%E6%8A%80/%E4%B8%AD%E5%9C%8B%E9%80%B2%E5%8F%A3%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E7%9A%84%E7%99%BC%E5%B1%95%E5%92%8C%E6%B8%AF%E5%95%86%E7%9A%84%E6%A9%9F%E9%81%87/rp/tc/1/1X3L128M/1X0A3HYN.htm#" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;color:rgb(51, 51, 51);text-decoration:none;"><en-media type="image/jpeg" hash="4246d303f1388428d54d358d8a827813" title="圖：直購進口" border="0" alt="圖：直購進口" width="600" height="524" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;vertical-align:middle;margin-bottom:10px;width:600px;"></en-media></a><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:13px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"></div></div></div></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;clear:both;"> </span></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span></div><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">跨境電商平台購買進口商品繳納行郵稅</strong></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">中國內地消費者通過跨境電商平台購買外國商品，需根據《<a href="http://www.customs.gov.cn/publish/portal0/tab3889/module1188/info362458.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">中華人民共和國進境物品歸類表</a>》(海關總署公告2012年第15號)按實際零售價格計算進口稅。而根據海關總署公告2010年第43號《<a href="http://www.customs.gov.cn/publish/portal0/tab517/info231089.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">關於調整進出境個人郵遞物品管理措施有關事宜</a>》，規定個人郵遞進境物品依法徵收進口稅(簡稱行郵稅)。按照中國海關總署要求，消費者在跨境電商平台下單時，需要提供個人身分證進行驗證。海關總署會以「個人自用，合理數量」為原則，單次訂單購買多個商品，訂單金額在1,000元以下的，海關將按行郵稅辦理通關；若金額超出規定1,000元限值的，應按照一般貿易進口(需繳交關稅和增值稅)辦理通關手續。單次購買一件不可分割的商品(例如嬰兒手推車、手袋等)若超出1,000元的限值，經海關審核屬個人自用的，仍可參照個人物品規定按行郵稅辦理通關。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">行郵稅的稅率比一般貿易進口徵收的關稅和增值稅(17%)的稅率低；應徵進口稅額在50元或以下的，海關予以免稅。目前行郵稅的稅率分為4種：10%、20%、30%及50%。舉例來說，通過跨境電商平台購買一包銷售價格130元的紙尿褲，行郵稅率10%，購買一包的稅額是13元，稅額低於50元，不需繳稅。若一次購買4包紙尿褲，稅額一共是52元，便需要繳交52元的行郵稅。</p><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;background-color:rgb(255, 255, 255);"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span><div style="margin:0px auto;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;padding-left:50px;"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;"> </span><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:600px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;margin-top:5px;margin-bottom:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"> <a href="http://service-industries-research.hktdc.com/business-news/article/%E8%B3%87%E8%A8%8A%E5%8F%8A%E9%80%9A%E8%A8%8A%E7%A7%91%E6%8A%80/%E4%B8%AD%E5%9C%8B%E9%80%B2%E5%8F%A3%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E7%9A%84%E7%99%BC%E5%B1%95%E5%92%8C%E6%B8%AF%E5%95%86%E7%9A%84%E6%A9%9F%E9%81%87/rp/tc/1/1X3L128M/1X0A3HYN.htm#" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;color:rgb(51, 51, 51);text-decoration:none;"><en-media type="image/jpeg" hash="9d677cd388505471c159eeecb5fff134" title="表：部分產品個人物品「進口稅率」(按行郵稅)" border="0" alt="表：部分產品個人物品「進口稅率」(按行郵稅)" width="600" height="342" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;vertical-align:middle;margin-bottom:10px;width:600px;"></en-media></a><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:13px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"></div></div></div></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;clear:both;"> </span></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span></div><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">跨境電商平台O2O的獨特之處</strong></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">中國內地消費者熱衷網上購物，但部分消費者仍喜歡到實體店看看商品的實物或體驗心儀的商品後才到網購平台購買。尤其是跨境電商平台銷售的外國進口商品，部分是內地消費市場未曾出現的新商品和新品牌，因此內地消費者更有興趣到體驗店親自瞭解實物。不過與其他電商平台的實體店不同，跨境電商平台體驗店內部分商品只作展示，消費者可以於體驗店現場上網下單，但不能現場提取商品，商品會以速遞方式發送給消費者。不過，部分的體驗店會有已完稅商品售賣，讓消費者現場購買後即時提取。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">例如跨境電商平台「風信子跨境直購商城」，在廣州南沙的跨境商品直購體驗中心分別有「跨境商品展示區」和「完稅商品售賣區」。據瞭解，消費者購買在「跨境商品展示區」的商品需繳交行郵稅，他們可以現場親自瞭解商品後，即時通過「風信子跨境直購商城」購買，商品會以速遞方式送到消費者的家中。在「完稅商品售賣區」的商品售價已包含關稅和增值稅，消費者可以直接取商品到收銀台付款，現場提取商品。「完稅商品售賣區」的商品比內地市場的同類商品價格略低，因為當中減少了經銷商、代理商、物流運輸等流通環節的成本。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">跨境電商平台由國家發展改革委、人民銀行、檢驗檢疫局、海關總署等相關政府部門監管，有完善的產品質量安全評估、產品抽檢制度、缺陷產品召回處置制度、產品流向溯源管理制度、消費者權益保護制度等。中國內地消費者通過跨境電商平台購買海外商品，相對以海淘和代購方式保障更全面，在退貨和更換產品方面更為方便。加上一些跨境電商平台有購體驗中心，讓消費者現場瞭解商品，相信越來越多的內地消費者會轉向跨境電商平台購買海外商品。</p><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;background-color:rgb(255, 255, 255);"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span><div style="margin:0px auto;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;padding-left:50px;"><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;"> </span><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:305px;margin-right:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;margin-top:5px;margin-bottom:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"> <a href="http://service-industries-research.hktdc.com/business-news/article/%E8%B3%87%E8%A8%8A%E5%8F%8A%E9%80%9A%E8%A8%8A%E7%A7%91%E6%8A%80/%E4%B8%AD%E5%9C%8B%E9%80%B2%E5%8F%A3%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E7%9A%84%E7%99%BC%E5%B1%95%E5%92%8C%E6%B8%AF%E5%95%86%E7%9A%84%E6%A9%9F%E9%81%87/rp/tc/1/1X3L128M/1X0A3HYN.htm#" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;color:rgb(51, 51, 51);text-decoration:none;"><en-media type="image/jpeg" hash="16f24c12ee0f4d06910e24027a7d0fc1" title="相片：跨境商品展示區的商品：消費者需要取商品標籤到收銀台下單，速遞公司會把商品發送給消費者。" border="0" alt="相片：跨境商品展示區的商品：消費者需要取商品標籤到收銀台下單，速遞公司會把商品發送給消費者。" width="305" height="229" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;vertical-align:middle;margin-bottom:10px;width:305px;"></en-media></a><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:13px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;">跨境商品展示區的商品：消費者需要取商品標籤到收銀台下單，速遞公司會把商品發送給消費者。</div></div></div></div><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;position:relative;min-height:1px;float:left;width:305px;margin-right:0px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;text-transform:none;margin-top:5px;margin-bottom:10px;"><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;"> <a href="http://service-industries-research.hktdc.com/business-news/article/%E8%B3%87%E8%A8%8A%E5%8F%8A%E9%80%9A%E8%A8%8A%E7%A7%91%E6%8A%80/%E4%B8%AD%E5%9C%8B%E9%80%B2%E5%8F%A3%E8%B7%A8%E5%A2%83%E9%9B%BB%E5%95%86%E7%9A%84%E7%99%BC%E5%B1%95%E5%92%8C%E6%B8%AF%E5%95%86%E7%9A%84%E6%A9%9F%E9%81%87/rp/tc/1/1X3L128M/1X0A3HYN.htm#" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;color:rgb(51, 51, 51);text-decoration:none;"><en-media type="image/jpeg" hash="541bf9413522b0b94389f60c442cb704" title="相片：完稅商品售賣區的商品：消費者可以直接取商品到收銀台付款，現場提取商品。" border="0" alt="相片：完稅商品售賣區的商品：消費者可以直接取商品到收銀台付款，現場提取商品。" width="305" height="229" style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;vertical-align:middle;margin-bottom:10px;width:305px;"></en-media></a><div style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:13px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;word-wrap:break-word;white-space:normal;box-sizing:border-box;">完稅商品售賣區的商品：消費者可以直接取商品到收銀台付款，現場提取商品。</div></div></div></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;text-transform:none;display:table;clear:both;"> </span></div><span style="font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:inherit;white-space:normal;box-sizing:border-box;"></span></div><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"> </p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">跨境電子商務商品的檢驗檢疫</strong></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">根據質檢總局發布《<a href="http://www.aqsiq.gov.cn/xxgk_13386/tzdt/zztz/201505/t20150514_439487.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">關於進一步發揮檢驗檢疫職能作用促進跨境電子商務發展的意見</a>》，提出加快建立跨境電子商務的檢驗檢疫工作機制，並支持中國(杭州)跨境電子商務綜合實驗區發展，鼓勵先行先試，進一步下放審批權限給予所在地的檢驗檢疫機構，並複製和推廣到其他跨境電子商務地區。當中明確了檢驗檢疫機構對跨境電子商務經營主體[6]及商品實施備案管理，落實質量安全責任可追溯。根據《<a href="http://www.ha.ziq.gov.cn/portal/chnl311920/325984.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">杭州出入境檢驗檢疫局入境電子商務企業和產品備案管理工作規範</a>》，從事進口跨境電子商務的企業，在產品首次上線銷售前必須進行備案，包括填寫「跨境電商企業檢驗檢疫備案申請表」和「質量誠信經營承諾書」。當中備案的資料包括：企業基本資料和經營商品名稱、品牌、HS編碼、規格型號、原產國、供應商名稱等。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">通過跨境電商平台銷售的商品，進口的檢驗檢疫程序相對一般貿易進口較為簡單。不屬於跨境電子商務的「負面清單」內的產品[7]，一般都可順利進口，不過目前各個試點在運作上可能有分別。一些產品，例如進口食品和化妝品，也不需要重新做產品標籤。據報道，國家質檢總局下放部分審批權予浙江出入境檢驗檢疫局，進一步縮短辦事時間。例如進口食品、動植物及動植物產品的檢疫許可審批時限從20個工作日縮短至5個工作日，部分產品可以實現當日申請當日審批；並對進口商品免辦3C認證進行風險評估。由於中國(杭州)跨境電子商務綜合實驗區屬於先行先試的跨境電商服務試點城市，其運作模式可能會複製和推廣到其他跨境電子商務地區。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">消費者在跨境電商平台購物的優點</strong></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">據瞭解，內地「海淘族」購買外國的商品需要先登入外國的購物網站，下單後，尋找轉運公司，商品經國際物流郵寄/速遞到中國，商品有機會被中國海關抽檢、扣貨、徵稅等。對內地消費者來說，在外國網站購物對外國語言、物流速遞、外幣種類的要求較繁瑣；因此部分消費者會利用「海外代購」方式購買。不過，通過海淘和代購方式購買外國商品，內地消費者往往無法退貨或更換商品，而且商品的品質未必有保證。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">相反，內地消費者在跨境電商平台購物會受到《<a href="http://www.gov.cn/jrzg/2013-10/25/content_2515455.htm" target="_blank" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">中華人民共和國消費者權益保護法</a>》保障[8]，消費者有權自收到商品起7日內退貨，無需說明理由(除了部分不適用的商品，例如消費者訂製商品、個人護理/貼身類商品、期刊週刊商品等)。若商品的功能故障或質量問題，消費者可選擇換貨或退貨。另一方面，跨境電商平台由國家發展改革委、人民銀行、檢驗檢疫局、海關總署等相關政府部門監管，是內地消費者購買外國進口商品的合法和安全的渠道。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"><strong style="margin:0px;padding:0px;border:0px;font-family:inherit;font-size:inherit;font-style:inherit;font-variant:inherit;font-weight:bold;line-height:inherit;word-wrap:break-word;white-space:normal;">跨境電子B2C給港商的商機</strong></p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">中國政府積極發展跨境電子商務，藉著先行先試不斷細化相關的政策，鼓勵海淘「陽光化」，相信跨境電商平台的發展潛力深厚。香港的企業有多年與外國商家合作的經驗，熟悉外國供應商的產品，同時又瞭解中國內地消費者的需求特徵，所以香港的貿易商、進口商和代理商等，在引入外國進口產品到內地市場上有一定的優勢。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">另一方面，通過跨境電商平台銷售的商品在檢驗檢疫程序上相對一般進口貿易較簡單，產品審批流程需時較短、整體進口和供應鏈的成本降低，港商可以引進更多不同品牌和種類的產品到中國市場。現時跨境電商平台主要銷售商品包括：母嬰用品、個人護理產品、進口食品、保健品、美容化妝品等大眾消費商品。據瞭解，大部分在跨境電商平台購物的消費者已有一般的網購經驗，他們對商品要求相對較高，喜歡發掘中國內地未有的新產品和新品牌，將會是香港企業或品牌的中高端目標消費群。雖然目前只有部分內地城市能展開跨境電商B2C的銷售業務，但全國內地的消費者都可以通過不同試點城市的跨境電商平台購物，因此跨境電商平台的潛在消費群是內地整個消費市場。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">一些有意拓展內地跨境電商B2C銷售業務的港商，可能對電子商務或網絡銷售的運作並不熟悉，可以考慮與跨境電子商務公司合作。部分電子商務公司能提供整套網絡銷售或個別項目的服務(例如報關商檢、市場推廣、<a href="http://economists-pick-research.hktdc.com/business-news/article/%E7%B6%93%E8%B2%BF%E8%BE%AD%E5%BD%99/%E7%B6%93%E8%B2%BF%E8%BE%AD%E5%BD%99-O2O/glossary/tc/1/1X338PFI/1X09WBEP.htm" style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;color:blue;text-decoration:underline;">O2O</a>銷售、物流配送、商品追溯等)；部分甚至能發揮代理商的角色和功能，協助港商管理不同跨境電商平台的運作，讓港商專注時間和資源在研發新產品和增強核心業務的競爭力。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;"> </p><hr></hr><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[1]  跨境電子商務通關模式共有4種：「一般進口」、「保稅進口」、「一般出口」和「保稅出口」；針對企業對個人消費者(B2C)的銷售，本文將探討「一般進口」和「保稅進口」的通關模式。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[2]  跨境電商是經營跨境電商平台的公司，當中包括B2B(企業對企業的銷售)和B2C，本文將探討B2C的銷售。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[3]  跨境電商平台是指向中國內地消費銷售海外進口商品的第三方網站或企業自建的網站。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[4]  海淘族是指中國內地的消費者直接在外國網站下單購物，商品通過國際物流或轉運公司郵寄或快遞到中國內地。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[5]  跨境貿易電子商務一般是指不同關境的交易主體，通過電子商務平台達成交易、進行支付結算，並通過跨境物流送達商品、完成交易的一種商業活動。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[6]  跨境電子商務經營主體包括：跨境電子商務經企業(電商經營企業)、跨境電子商務平台企業(電商平台企業)和跨境電子商品物流倉儲企業。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[7] 「負面清單」是指某些商品種類是不能以跨境電商方式進口銷售，例如放射性產品、化學危險品和廢舊物品。</p><p style="margin:0px;padding:0px;border:0px;font-family:Verdana, Arial, 細明體, 新細明體, Helvetica, sans-serif;font-size:15px;font-style:inherit;font-variant:inherit;font-weight:inherit;line-height:1.6em;word-wrap:break-word;white-space:normal;padding-bottom:10px;">[8]  修改後的《中華人民共和國消費者權益保護法》在2014年3月15日起實行。</p>
				</span>
			
		
		

	


 		

	
	 

	
	 
	
 


 










