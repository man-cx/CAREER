<note><title>Overhead Projector Purchase</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><br/>
	<div style="font-size: 16px">
		<div style="text-align:center;font-family:Arial, Helvetica, sans-serif;outline:0px;vertical-align:baseline;background-color:transparent;font-size:12px;">
			<div style="outline:0px;vertical-align:baseline;background-color:rgb(242, 242, 242);line-height:1;font-family:Arial, Helvetica, sans-serif;color:rgb(77, 77, 77);">
    
				<div style="margin:0px auto;padding:0px;border:0px;outline:0px;vertical-align:baseline;background-color:transparent;width:1000px;">
        
					<div style="margin:0px auto;padding:0px;border:0px;outline:0px;vertical-align:baseline;background-color:transparent;z-index:150;position:relative;width:940px;text-align:left;">
                
						<div style="margin:0px;padding:0px;border:0px;outline:0px;vertical-align:baseline;background-color:transparent;margin-bottom:5px;text-align:right;">
        
							<ul style="margin:0px;padding:0px;border:0px;outline:0px;vertical-align:baseline;background-color:transparent;list-style:none;overflow:hidden;padding-top:5px;line-height:1.4;">
            
